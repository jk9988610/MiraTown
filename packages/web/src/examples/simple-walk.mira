@BEGIN title="简单行走"

@ACT id=1 title="一个人"

@SCENE id=plaza time=evening weather=clear

@CAST actor=mira

@ENTER actor=mira at=(10, 8) facing=east

@DIALOGUE speaker=mira auto=true auto_delay=2
「我要去广场中央看看。」
@END

@MOVE_TO actor=mira to_zone=plaza_center duration=3

@DIALOGUE speaker=mira auto=true auto_delay=2
「到了。」
@END

@END_SCRIPT
