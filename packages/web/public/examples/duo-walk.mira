language: zh-CN
---

@BEGIN title="双人同行"

@ACT id=1 title="并肩前行"

@SCENE id=plaza time=evening weather=clear

@CAST actor=mira
@CAST actor=old_chen

@SPAWN_PROP prop=lamp_post id=lamp_1 at=(32, 26) state=on
@SPAWN_PROP prop=bench id=bench_1 at=(34, 26) state=empty

@ENTER actor=mira at=(26, 24) facing=east
@ENTER actor=old_chen at=(28, 24) facing=east

@DIALOGUE speaker=mira auto=true auto_delay=2
「陈伯，我们去路灯下坐坐吧。」
@END

@DIALOGUE speaker=old_chen auto=true auto_delay=2
「好，慢慢走。」
@END

@PARALLEL
  @MOVE_TO actor=mira to=(33, 26) speed=1.2
  @MOVE_TO actor=old_chen to=(35, 26) speed=1.2
@END

@SIT actor=mira bench=bench_1 seat=0
@SIT actor=old_chen bench=bench_1 seat=1

@FACE actor=mira facing=north
@FACE actor=old_chen facing=north

@DIALOGUE speaker=old_chen auto=true auto_delay=2.5
「到了，这儿的晚风真舒服。」
@END

@NARRATION duration=2
两个人在路灯下并肩坐下，夜色渐渐柔和。

@END_SCRIPT
