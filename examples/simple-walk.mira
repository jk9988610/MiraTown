@BEGIN title="简单行走"

@ACT id=1 title="一个人"

@SCENE id=plaza time=evening weather=clear

@CAST actor=mira

@SPAWN_PROP prop=lamp_post id=lamp_1 at=(30, 26) state=on
@SPAWN_PROP prop=bench id=bench_1 at=(32, 26) state=empty

@ENTER actor=mira at=(22, 24) facing=south

@DIALOGUE speaker=mira auto=true auto_delay=2
「路灯下有条长椅，过去坐坐。」
@END

@MOVE_TO actor=mira to=(31, 26)

@SIT actor=mira bench=bench_1 seat=0

@DIALOGUE speaker=mira auto=true auto_delay=2
「到了。」
@END

@END_SCRIPT
