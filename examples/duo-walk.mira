@BEGIN title="双人同行"

@ACT id=1 title="并肩前行"

@SCENE id=plaza time=evening weather=clear

@CAST actor=mira
@CAST actor=old_chen

@SPAWN_WALKWAY id=plaza_main_lane_left from=(20, 25.55) to=(37, 25.55) width=1.2
@SPAWN_WALKWAY id=plaza_main_lane_right from=(20, 26.15) to=(37, 26.15) width=1.2

@LAYOUT id=plaza_main_row

@ENTER actor=mira at=(28, 25.55) facing=south
@ENTER actor=old_chen at=(28.5, 26.15) facing=south

@DIALOGUE speaker=mira auto=true auto_delay=2
「陈伯，我们去路灯下坐坐吧。」
@END

@DIALOGUE speaker=old_chen auto=true auto_delay=2
「好，慢慢走。」
@END

@PARALLEL
  @MOVE_TO actor=mira to_path=plaza_main_lane_left x=32
  @MOVE_TO actor=old_chen to_path=plaza_main_lane_right x=32
@END

@PARALLEL
  @MOVE_TO actor=mira to_path=plaza_main_lane_left x=33.6
  @MOVE_TO actor=old_chen to_path=plaza_main_lane_right x=34.2
@END

@SIT actor=mira bench=bench_1 seat=0
@SIT actor=old_chen bench=bench_1 seat=1

@DIALOGUE speaker=old_chen auto=true auto_delay=2.5
「到了，这儿的晚风真舒服。」
@END

@NARRATION duration=2
两个人在路灯下并肩坐下，夜色渐渐柔和。

@END_SCRIPT
